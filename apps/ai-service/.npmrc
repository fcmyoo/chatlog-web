# 强制使用精确版本，避免意外的依赖更新
save-exact=true

# 使用npm ci进行安装，确保依赖一致性
package-lock=true

# 启用审计功能
audit-level=moderate

# 禁用可选依赖的安装失败导致整体失败
optional=false

# 设置registry（如果需要使用私有registry）
# registry=https://registry.npmjs.org/

# 启用进度条
progress=true

# 设置日志级别
loglevel=warn

# 禁用更新检查以提高安装速度
update-notifier=false

# 设置缓存目录（可选）
# cache=/path/to/npm/cache

# 启用严格的SSL检查
strict-ssl=true