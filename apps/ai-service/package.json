{
  "name": "ai-service",
  "version": "1.0.0",
  "description": "AI-powered service for intelligent data processing and analysis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "start:prod": "node dist/index.js",
    "dev": "node --loader ts-node/esm --watch src/index.ts",
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "security:audit": "audit-ci --config audit-ci.json",
    "security:check": "npm audit --audit-level moderate",
    "deps:check": "ncu",
    "deps:update": "ncu -u",
    "clean": "rm -rf dist node_modules/.cache",
    "prestart:prod": "npm run build"
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "langchain",
    "openai",
    "google-genai",
    "typescript",
    "express",
    "api",
    "microservice"
  ],
  "author": "AI Service Team",
  "license": "MIT",
  "dependencies": {
    "@langchain/google-genai": "0.2.15",
    "@langchain/openai": "0.6.2",
    "axios": "1.11.0",
    "dotenv": "17.2.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.1.0",
    "audit-ci": "7.1.0",
    "jest": "30.0.5",
    "npm-check-updates": "18.0.2",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3",
    "@babel/plugin-transform-runtime": "^7.28.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/chatlog-web.git",
    "directory": "apps/ai-service"
  },
  "bugs": {
    "url": "https://github.com/your-org/chatlog-web/issues"
  },
  "homepage": "https://github.com/your-org/chatlog-web/tree/main/apps/ai-service#readme"
}
