# AI服务器配置
AI_SERVER_PORT=3001
NODE_ENV=development

# Chatlog API配置
CHATLOG_API_BASE=http://127.0.0.1:5030

# AI模型配置
MODEL_PROVIDER=DeepSeek

# DeepSeek API配置
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner

# Gemini API配置 (可选)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# LangChain配置
LANGCHAIN_VERBOSE=false
LANGCHAIN_CACHE=true
LANGCHAIN_TIMEOUT=300000

# 定时任务配置
ENABLE_SCHEDULED_ANALYSIS=false
SCHEDULED_ANALYSIS_TIME=0 0 8 * * *
MAX_CONCURRENT_ANALYSIS=2
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# 性能配置
ANALYSIS_BATCH_SIZE=10
ANALYSIS_INTERVAL=3000
MAX_PROMPT_LENGTH=50000

# 前端配置
VUE_APP_AI_API_BASE=http://localhost:3001