# Chatlog Web AI 服务配置
# 根据实际情况修改这些配置

# Chatlog API 服务配置
CHATLOG_HOST=127.0.0.1
CHATLOG_PORT=5030
CHATLOG_PROTOCOL=http

# AI 分析服务配置  
AI_HOST=localhost
AI_PORT=3001
AI_PROTOCOL=http

# 前端服务配置
FRONTEND_HOST=localhost
FRONTEND_PORT=8080
FRONTEND_PROTOCOL=http

# AI 模型配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_AI_MODEL=deepseek

# 应用配置
NODE_ENV=development
LOG_LEVEL=info

# 定时任务配置
ENABLE_SCHEDULED_ANALYSIS=false
SCHEDULED_ANALYSIS_TIME="0 0 8 * * *"
MAX_CONCURRENT_ANALYSIS=2